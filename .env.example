DATABASE_URL=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
SELECTED_DB=production
# Same Atlas cluster as DATABASE_URL/SELECTED_DB above, just a different
# database name — owned by the separate cp-companion service.
COMPANION_DB=cp_companion
AUTH_EMAIL=admin@example.com
AUTH_PASSWORD=replace-with-a-long-password
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
