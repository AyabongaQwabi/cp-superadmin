DATABASE_URL=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
SELECTED_DB=production
# Derived operational read-model database on the same Atlas cluster.
COMPANION_DB=cp_companion
ADMIN_COMPANION_DB=clinicplus_admin_companion
ADMIN_COMPANION_BASE_URL=http://localhost:3001
AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# cp-ai-companion-server (AI assistant agent) integration.
# Shared secret checked on both /api/ai/* (incoming, from the agent server)
# and /api/assistant/chat (outgoing, to the agent server). Do not reuse
# ADMIN_STATS_SECRET here -- this is a separate trust boundary.
AI_AGENT_SECRET=replace-with-a-long-random-secret
AI_AGENT_URL=http://localhost:8787
